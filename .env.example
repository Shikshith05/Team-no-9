# Backend
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=myapp_db

# Stock market API
STOCK_PRICE_API_URL=https://api.example.com/stocks/{symbol}
STOCK_PRICE_API_KEY=your_stock_api_key

# Gold market API
GOLD_PRICE_API_URL=https://api.example.com/gold
GOLD_PRICE_API_KEY=your_gold_api_key

# Price refresh settings
VALUATION_REFRESH_INTERVAL_MS=60000
PRICE_API_TIMEOUT_MS=8000
PRICE_STALE_AFTER_MS=60000