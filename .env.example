# Copy to .env in the repository root and fill in your own values. Never commit .env.

# Backend
PORT=5000

# JWT (PRJ-SR-003). The backend will not start without JWT_SECRET.
# The placeholder works for local development only; with NODE_ENV=production
# (the Docker setup) the API refuses to start with it.
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
# How long a login lasts: "24h", "30m", "7d", or a number of seconds.
JWT_EXPIRES_IN=24h

# The only browser origin allowed by CORS. Local development: the Vite dev server.
# Docker: use https://localhost, or your real https:// address.
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=pwm
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=pwm_app

# Market price feeds (optional). The refresh scheduler only starts when both
# URLs are set, and they must use https. Example values:
#   STOCK_PRICE_API_URL=https://api.example.com/stocks/{symbol}
#   GOLD_PRICE_API_URL=https://api.example.com/gold
STOCK_PRICE_API_URL=
STOCK_PRICE_API_KEY=
GOLD_PRICE_API_URL=
GOLD_PRICE_API_KEY=

# Price refresh settings
# Default once a day (PWM-F-020). Each run writes one valuation row per holding.
VALUATION_REFRESH_INTERVAL_MS=86400000
PRICE_API_TIMEOUT_MS=8000
PRICE_STALE_AFTER_MS=60000
